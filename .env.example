# GEMINI_API_KEY: Required for Gemini AI API calls in the agent chat.
# Set this in Vercel Environment Variables (Settings > Environment Variables).
# Get your key at: https://aistudio.google.com/app/apikey
# If Google revokes the key ("Your API key was reported as leaked"), create a new
# one and replace this value in both .env and Vercel.
GEMINI_API_KEY=

# GEMINI_API_KEY_FALLBACK: Optional second key. The server automatically retries
# with it if the primary key fails with 401/403/429/5xx, so one revoked key does
# not take the assistant offline.
GEMINI_API_KEY_FALLBACK=

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
